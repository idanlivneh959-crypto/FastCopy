<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastCopy" Height="600" Width="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Source -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Label Content="Source" Width="80" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <Button x:Name="BrowseSource" Content="Browse..." Width="90" DockPanel.Dock="Right" Margin="6,0,0,0"/>
            <TextBox x:Name="SourceBox" VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- Destination -->
        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <Label Content="Destination" Width="80" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <Button x:Name="BrowseDest" Content="Browse..." Width="90" DockPanel.Dock="Right" Margin="6,0,0,0"/>
            <TextBox x:Name="DestBox" VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- Options -->
        <GroupBox Grid.Row="2" Header="Options" Margin="0,0,0,6" Padding="6">
            <WrapPanel>
                <Label Content="Threads /MT" VerticalAlignment="Center"/>
                <TextBox x:Name="MtBox" Text="16" Width="48" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                <Label Content="Retries /R" VerticalAlignment="Center"/>
                <TextBox x:Name="RetriesBox" Text="1" Width="40" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                <Label Content="Wait /W" VerticalAlignment="Center"/>
                <TextBox x:Name="WaitBox" Text="1" Width="40" Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="ChkJ" Content="Unbuffered /J" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox x:Name="ChkSplit" Content="Split by size (two passes)" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox x:Name="ChkMirror" Content="Mirror /MIR (deletes extras!)" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox x:Name="ChkCompress" Content="SMB compress /COMPRESS" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <CheckBox x:Name="ChkDryRun" Content="Dry run /L" VerticalAlignment="Center"/>
            </WrapPanel>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="BtnStart" Content="Start Copy" Width="110" Height="30" Margin="0,0,8,0"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="90" Height="30" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="BtnTune" Content="Auto-tune /MT" Width="120" Height="30"/>
        </StackPanel>

        <!-- Command preview -->
        <TextBox Grid.Row="4" x:Name="CmdPreview" IsReadOnly="True" TextWrapping="Wrap"
                 Background="#F4F4F4" FontFamily="Consolas" Height="56" Margin="0,0,0,6"
                 VerticalScrollBarVisibility="Auto"/>

        <!-- Log -->
        <TextBox Grid.Row="5" x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas"
                 TextWrapping="NoWrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

        <!-- Status -->
        <DockPanel Grid.Row="6" Margin="0,6,0,0">
            <ProgressBar x:Name="Progress" Width="160" Height="16" DockPanel.Dock="Right"/>
            <TextBlock x:Name="StatusText" Text="Ready." VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
